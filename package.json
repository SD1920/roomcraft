{
  "name": "roomcraft",
  "private": true,
  "type": "module",
  "description": "roomcraft: scan a room with your phone, design it in 2D/3D, furnish it with AI",
  "scripts": {
    "build": "npm --prefix frontend ci --include=dev && npm --prefix frontend run build",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "test": "npm --prefix frontend test"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0",
    "resend": "^3.2.0"
  }
}
