# ── Database ──────────────────────────────────────────────────
# Local:   postgresql://postgres:yourpassword@localhost:5432/roomcraft
# Railway: copy the connection string from your Railway project
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/roomcraft

# ── JWT ───────────────────────────────────────────────────────
# Generate a strong secret:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# ── Email (Resend) ────────────────────────────────────────────
# Free tier at resend.com — 3000 emails/month
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── Server ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Frontend URL (for CORS) ───────────────────────────────────
# Local:   http://localhost:5173
# Vercel:  https://yourapp.vercel.app
CLIENT_URL=http://localhost:5173

# ── Avatar uploads ────────────────────────────────────────────
# Max file size in bytes (default 2 MB)
MAX_AVATAR_SIZE=2097152

# ── AI room assistant (optional) ──────────────────────────────
# Any subset of these keys works; each one adds that provider's models to the
# chain (utils/llm/models.js). All have free tiers, no billing.
# With no key at all the chat still answers in "quick mode" (simple rules).
#   Gemini       aistudio.google.com (also used by the camera guess)
#   Groq         console.groq.com -> API Keys
#   OpenRouter   openrouter.ai -> Keys
#   Hugging Face huggingface.co -> Settings -> Access Tokens (Read, with
#                "Make calls to Inference Providers")
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=
# Optional: replace the model list, comma separated provider:model, e.g.
# AI_MODELS=groq:llama-3.3-70b-versatile,gemini:gemini-3.1-flash-lite
AI_MODELS=
